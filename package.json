{
  "name": "arina-osint-nickname-checker",
  "version": "3.0.0",
  "description": "An OSINT (open source intelligence tool) to find info about your old pages.",
  "main": "dist/index.js",
  "scripts": {
    "format": "prettier . -w",
    "lint": "eslint . --ext .ts",
    "prebuild": "npm run lint",
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js"
  },
  "keywords": [
    "osint",
    "nickname",
    "checker",
    "arina-osint"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
